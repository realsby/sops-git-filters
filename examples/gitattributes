# Copy the relevant lines into your repo's .gitattributes.
# filter=sops → transparent encrypt (git add) / decrypt (checkout)
# diff=sops   → `git diff` / `git log -p` show decrypted content
# merge=sops  → merges, rebases, cherry-picks and stash pops work on the
#               decrypted content (merge-driver.sh). Without it, two
#               branches that both changed a secret cannot be merged.

.env                    filter=sops diff=sops merge=sops
**/.env                 filter=sops diff=sops merge=sops
secrets/deploy.key      filter=sops diff=sops merge=sops
config/credentials.yaml filter=sops diff=sops merge=sops
